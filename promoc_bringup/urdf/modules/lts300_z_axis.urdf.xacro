<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include dependencies -->
  <xacro:include filename="$(find promoc_bringup)/urdf/properties/lts300_properties.xacro"/>
  <xacro:include filename="$(find promoc_bringup)/urdf/properties/materials.xacro"/>

  <!-- LTS300 Z-Axis Macro (vertical mounting) -->
  <xacro:macro name="lts300_z_axis" params="prefix parent_link 
                                            mount_x:=0 mount_y:=0 mount_z:=0 
                                            mount_roll:=0 mount_pitch:=0 mount_yaw:=0
                                            enable_ros2_control:=true">

    <!-- Z-Axis Housing (stationary, mounted vertically) -->
    <link name="${prefix}_z_housing">
      <visual>
        <geometry>
          <!-- Rotated for vertical mounting -->
          <box size="${lts300_housing_width} ${lts300_housing_height} ${lts300_housing_length}"/>
        </geometry>
        <material name="lts300_housing"/>
      </visual>
      <collision>
        <geometry>
          <box size="${lts300_housing_width} ${lts300_housing_height} ${lts300_housing_length}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${lts300_housing_mass}"/>
        <origin xyz="0 0 0"/>
        <!-- Inertia adjusted for vertical orientation -->
        <inertia ixx="${(lts300_housing_mass/12) * (lts300_housing_height*lts300_housing_height + lts300_housing_length*lts300_housing_length)}"
                 ixy="0.0" ixz="0.0"
                 iyy="${(lts300_housing_mass/12) * (lts300_housing_width*lts300_housing_width + lts300_housing_length*lts300_housing_length)}"
                 iyz="0.0"
                 izz="${(lts300_housing_mass/12) * (lts300_housing_width*lts300_housing_width + lts300_housing_height*lts300_housing_height)}"/>
      </inertial>
    </link>

    <!-- Z-Axis Carriage (moving vertically) -->
    <link name="${prefix}_z_carriage">
      <visual>
        <geometry>
          <box size="${lts300_carriage_length} ${lts300_carriage_width} ${lts300_carriage_height}"/>
        </geometry>
        <material name="z_axis_color"/>
      </visual>
      <collision>
        <geometry>
          <box size="${lts300_carriage_length} ${lts300_carriage_width} ${lts300_carriage_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${lts300_carriage_mass}"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="${(lts300_carriage_mass/12) * (lts300_carriage_width*lts300_carriage_width + lts300_carriage_height*lts300_carriage_height)}"
                 ixy="0.0" ixz="0.0"
                 iyy="${(lts300_carriage_mass/12) * (lts300_carriage_length*lts300_carriage_length + lts300_carriage_height*lts300_carriage_height)}"
                 iyz="0.0"
                 izz="${(lts300_carriage_mass/12) * (lts300_carriage_length*lts300_carriage_length + lts300_carriage_width*lts300_carriage_width)}"/>
      </inertial>
    </link>

    <!-- Mount housing to parent -->
    <joint name="${prefix}_z_housing_mount" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_z_housing"/>
      <origin xyz="${mount_x} ${mount_y} ${mount_z}" 
              rpy="${mount_roll} ${mount_pitch} ${mount_yaw}"/>
    </joint>

    <!-- Z-Axis Prismatic Joint -->
    <joint name="${prefix}_z_joint" type="prismatic">
      <parent link="${prefix}_z_housing"/>
      <child link="${prefix}_z_carriage"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>  <!-- Z-direction -->
      <limit lower="${-lts300_safe_travel/2}" 
             upper="${lts300_safe_travel/2}" 
             effort="${lts300_max_effort}" 
             velocity="${lts300_safe_velocity}"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>

    <!-- ros2_control interface (conditional) -->
    <xacro:if value="${enable_ros2_control}">
      <ros2_control name="${prefix}_z_lts300_system" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="${prefix}_z_joint">
          <command_interface name="position">
            <param name="min">${-lts300_safe_travel/2}</param>
            <param name="max">${lts300_safe_travel/2}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </ros2_control>
    </xacro:if>

  </xacro:macro>

</robot>

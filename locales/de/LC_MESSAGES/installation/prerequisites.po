#: ../../installation/prerequisites.md:1
msgid "Prerequisites"
msgstr "Voraussetzungen"

#: ../../installation/prerequisites.md:3
msgid "System Requirements"
msgstr "Systemanforderungen"

#: ../../installation/prerequisites.md:5
msgid "Operating System"
msgstr "Betriebssystem"

#: ../../installation/prerequisites.md:6
msgid "**Ubuntu 20.04 LTS** (Focal Fossa) - Recommended"
msgstr "**Ubuntu 20.04 LTS** (Focal Fossa) - Empfohlen"

#: ../../installation/prerequisites.md:7
msgid "**Ubuntu 22.04 LTS** (Jammy Jellyfish) - Supported"
msgstr "**Ubuntu 22.04 LTS** (Jammy Jellyfish) - Unterstützt"

#: ../../installation/prerequisites.md:8
msgid "**Ubuntu 24.04 LTS** (Noble Numbat) - Supported"
msgstr "**Ubuntu 24.04 LTS** (Noble Numbat) - Unterstützt"

#: ../../installation/prerequisites.md:10
msgid "Hardware Requirements"
msgstr "Hardware-Anforderungen"

#: ../../installation/prerequisites.md:11
msgid "**Minimum**: 4GB RAM, 2 CPU cores, 20GB disk space"
msgstr "**Minimum**: 4 GB RAM, 2 CPU-Kerne, 20 GB Festplattenspeicher"

#: ../../installation/prerequisites.md:12
msgid "**Recommended**: 8GB RAM, 4 CPU cores, 50GB disk space"
msgstr "**Empfohlen**: 8 GB RAM, 4 CPU-Kerne, 50 GB Festplattenspeicher"

#: ../../installation/prerequisites.md:13
msgid "**USB ports**: For Thorlabs LTS300 controllers"
msgstr "**USB-Anschlüsse**: Für Thorlabs LTS300-Controller"

#: ../../installation/prerequisites.md:14
msgid "**Network**: For planar motor communication"
msgstr "**Netzwerk**: Für die Kommunikation mit dem Planarmotor"

#: ../../installation/prerequisites.md:16
msgid "Software Dependencies"
msgstr "Software-Abhängigkeiten"

#: ../../installation/prerequisites.md:17
msgid "**Python**: 3.8 or newer"
msgstr "**Python**: 3.8 oder neuer"

#: ../../installation/prerequisites.md:18
msgid "**Git**: For source code management"
msgstr "**Git**: Für die Quellcodeverwaltung"

#: ../../installation/prerequisites.md:19
msgid "**Build tools**: GCC, CMake, Make"
msgstr "**Build-Tools**: GCC, CMake, Make"

#: ../../installation/prerequisites.md:21
msgid "ROS2 Compatibility"
msgstr "ROS2-Kompatibilität"

#: ../../installation/prerequisites.md:22
msgid "**ROS2 Humble Hawksbill** (Recommended)"
msgstr "**ROS2 Humble Hawksbill** (empfohlen)"

#: ../../installation/prerequisites.md:23
msgid "**ROS2 Iron Irwini** (Supported)"
msgstr "**ROS2 Iron Irwini** (unterstützt)"

#: ../../installation/prerequisites.md:24
msgid "**ROS2 Jazzy Jalisco** (Experimental)"
msgstr "**ROS2 Jazzy Jalisco** (experimentell)"

#: ../../installation/prerequisites.md:26
msgid "Hardware Compatibility"
msgstr "Hardware-Kompatibilität"

#: ../../installation/prerequisites.md:28
msgid "Supported Linear Axes"
msgstr "Unterstützte Linearachsen"

#: ../../installation/prerequisites.md:29
msgid "**Thorlabs LTS300** - Primary supported controller"
msgstr "**Thorlabs LTS300** - Hauptsächlich unterstützter Controller"

#: ../../installation/prerequisites.md:30
msgid "**Generic linear stages** - Via driver abstraction layer"
msgstr "**Generische Lineartische** - Über die Treiberabstraktionsschicht"

#: ../../installation/prerequisites.md:32
msgid "Supported Planar Motors"
msgstr "Unterstützte Planarmotoren"

#: ../../installation/prerequisites.md:33
msgid "PMCLib-compatible planar motor systems"
msgstr "PMCLib-kompatible Planarmotorsysteme"

#: ../../installation/prerequisites.md:34
msgid "Custom planar motor implementations via driver interface"
msgstr "Benutzerdefinierte Planarmotor-Implementierungen über die Treiberschnittstelle"

#: ../../installation/prerequisites.md:36
msgid "Optional Components"
msgstr "Optionale Komponenten"

#: ../../installation/prerequisites.md:37
msgid "**Gazebo Classic** - For simulation"
msgstr "**Gazebo Classic** - Für die Simulation"

#: ../../installation/prerequisites.md:38
msgid "**RViz2** - For visualization"
msgstr "**RViz2** - Zur Visualisierung"

#: ../../installation/prerequisites.md:39
msgid "**MoveIt2** - For motion planning (future integration)"
msgstr "**MoveIt2** - Für die Bewegungsplanung (zukünftige Integration)"

#: ../../installation/prerequisites.md:41
msgid "Next Steps"
msgstr "Nächste Schritte"

#: ../../installation/prerequisites.md:42
msgid "After verifying your system meets these requirements, proceed to the {doc}`system_setup` guide."
msgstr "Nachdem Sie überprüft haben, ob Ihr System diese Anforderungen erfüllt, fahren Sie mit der Anleitung {doc}`system_setup` fort."
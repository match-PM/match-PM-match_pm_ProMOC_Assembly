#: ../../appendix/faq.md:1
msgid "FAQ"
msgstr "FAQ"

#: ../../appendix/faq.md:3
msgid "Wie installiere ich alle Abhängigkeiten?"
msgstr "Wie installiere ich alle Abhängigkeiten?"

#: ../../appendix/faq.md:4
msgid "Mit `./setup/install_all.sh` im setup-Verzeichnis."
msgstr "Mit `./setup/install_all.sh` im setup-Verzeichnis."

#: ../../appendix/faq.md:6
msgid "Wie starte ich die Simulation?"
msgstr "Wie starte ich die Simulation?"

#: ../../appendix/faq.md:7
msgid "Mit `ros2 launch promoc_bringup dual_lts300_gazebo.launch.py`."
msgstr "Mit `ros2 launch promoc_bringup dual_lts300_gazebo.launch.py`."

#: ../../appendix/faq.md:9
msgid "Wie kann ich Hardware und Simulation unterscheiden?"
msgstr "Wie kann ich Hardware und Simulation unterscheiden?"

#: ../../appendix/faq.md:10
msgid "Über die Konfiguration in den Launchfiles und die verwendeten Treiber."
msgstr "Über die Konfiguration in den Launchfiles und die verwendeten Treiber."

#: ../../appendix/faq.md:12
msgid "Wo finde ich die API-Dokumentation?"
msgstr "Wo finde ich die API-Dokumentation?"

#: ../../appendix/faq.md:13
msgid "Im Menü unter \"API Reference\" oder im Verzeichnis `docs/api/`."
msgstr "Im Menü unter \"API-Referenz\" oder im Verzeichnis `docs/api/`."

#: ../../appendix/faq.md:15
msgid "Was tun bei Build-Fehlern?"
msgstr "Was tun bei Build-Fehlern?"

#: ../../appendix/faq.md:16
msgid "Siehe Troubleshooting und führe das Validierungsskript aus."
msgstr "Siehe Fehlerbehebung und führe das Validierungsskript aus."
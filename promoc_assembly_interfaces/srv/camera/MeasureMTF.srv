# Request: Parameters for MTF measurement

# Pixel size in micrometers (0 for default 3.45µm)
float32 pixel_size_um 0.0

# Auto ROI selection (true=automatic ROI, false=manual ROI selection)
bool auto_roi

# Manual ROI behaviour when auto_roi=false.
# Options:
# - "" or "direct_manual": directly measure the manually drawn ROI
# - "search_square_in_roi": draw a search ROI, detect one complete square inside it,
#   and derive the edge candidates from that square
string roi_detection_mode

# --- OPTIONAL MEASUREMENT CONDITIONS ---
# If values are not provided (empty/zero), the configured node parameters are used.
float64 coaxial_light_voltage
float64 coaxial_light_current
string camera_objective
float64 objective_magnification_x  # e.g. 1.0, 3.0, 6.0 (0 = auto/fallback)
bool use_beamsplitter              # True if beam splitter is in optical path
string notes

# Target Edge Selection (for squares)
# Options: "any" (default), "top", "right", "bottom", "left"
string target_edge


---

# Response: MTF measurement results

# True if measurement was successful
bool success

# Human-readable result message
string status_message

# MTF50 frequency (lp/mm) - frequency where MTF = 50%
float32 mtf50

# MTF20 frequency (lp/mm) - frequency where MTF = 20%
float32 mtf20

# MTF10 frequency (lp/mm) - frequency where MTF = 10%
float32 mtf10

# Detected edge angle (degrees)
float32 edge_angle

# Nyquist frequency (lp/mm)
float32 nyquist_frequency

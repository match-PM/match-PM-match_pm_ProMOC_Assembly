# Request: Parameters for MTF measurement

# Canonical measurement mode.
# Options:
# - "" or "auto": full-frame automatic square/target detection
# - "roi_search": search for one complete square inside roi_x/y/width/height
# - "direct_manual": measure roi_x/y/width/height directly as one edge ROI
# - "capture_only": capture raw fullframe + ROI stacks for offline analysis
# - "capture_only_direct": skip square search and capture roi_x/y/width/height directly
string measurement_mode

# Optional operator note copied into context.csv.
string notes

# Target edge selection for square detections.
# Options: "any" (default), "top", "right", "bottom", "left", "select"
string target_edge

# --- OPTIONAL ROI IN CURRENT MEASUREMENT IMAGE PIXELS ---
# Used when measurement_mode is "roi_search", "direct_manual", "capture_only",
# or "capture_only_direct".
# ROI is considered set when roi_width > 0 and roi_height > 0.
# If omitted for ROI modes, the operator can draw the ROI interactively.
int32 roi_x
int32 roi_y
int32 roi_width
int32 roi_height

---

# Response: MTF measurement results

# True if measurement was successful
bool success

# Human-readable result message
string status_message

# MTF50 frequency (lp/mm) - frequency where MTF = 50%
float32 mtf50

# MTF20 frequency (lp/mm) - frequency where MTF = 20%
float32 mtf20

# MTF10 frequency (lp/mm) - frequency where MTF = 10%
float32 mtf10

# Detected edge angle (degrees)
float32 edge_angle

# Nyquist frequency (lp/mm)
float32 nyquist_frequency

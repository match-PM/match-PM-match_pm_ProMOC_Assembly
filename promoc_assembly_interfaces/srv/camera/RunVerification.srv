# Request: Trigger full system verification pipeline
# Run full verification suite (Autofocus Comparison + MTF Validation)

# Configuration
bool run_autofocus_verification   # Check which algorithm is best
bool run_mtf_verification         # Check if system detects strahlteiler

# Parameters
float64 start_position_mm         # Start of AF search range
float64 end_position_mm           # End of AF search range
float64 step_size_mm              # Step size for AF (default 0.1)
int32 repetitions                 # Number of repetitions for statistics

# Metadata
string operator_name
string notes

---
# Response

bool success
string status_message
string report_path_pdf
string report_path_csv
string report_path_json

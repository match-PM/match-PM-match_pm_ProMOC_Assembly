# Request: Autofocus with algorithm selection

# Start position for the scan (in mm)
float64 start_position

# End position for the scan (in mm)
float64 end_position

# Step size for each move (in mm)

# --- ALGORITHM SELECTION ---
# 0 = Standard (Golden Section search, robust default)
# 1 = HillClimbing (fast, adaptive step size with early termination)
# 2 = Parabolic (iterative parabolic interpolation for sub-sample precision)
# 3 = Fibonacci (efficient Fibonacci sequence based search)
# 4 = Exhaustive (brute-force with minimum step, maximum precision reference)
int32 refinement_mode

# --- OPTIONAL: Expected Peak Value ---
# Used by HillClimbing to determine early termination
# If 0, default threshold is used
float64 estimated_peak_millions

# --- OPTIONAL: Use SIFT weighting in fine search ---
bool use_sift_weighting

# --- OPTIONAL MEASUREMENT CONDITIONS ---
# If empty/zero, node parameters are used
float64 coaxial_light_voltage
float64 coaxial_light_current
string camera_objective
string notes

---

# Response: Result of the autofocus operation

bool success
string status_message
float64 best_focus_position
float64 best_focus_value
int32 total_measurements_taken
float64 duration_seconds

# Request: Verification of Autofocus Peak vs. MTF Peak
# Scans a range and compares the position of max Tenengrad vs max MTF

float64 start_position    # Start position in mm
float64 end_position      # End position in mm
float64 step_size         # Step size for scan (default: 1.0)

float64 settle_time       # Wait time before image capture (default: 0.5)

---
bool success
string status_message
float64 peak_shift        # Difference between AF and MTF peak (mm)
float64 max_af_pos        # Position of max AF metric
float64 max_mtf_pos       # Position of max MTF metric

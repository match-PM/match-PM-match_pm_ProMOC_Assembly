# Request: Autofocus verification with algorithm comparison
# Runs all algorithms and compares results against ExhaustiveAutofocus reference

# Search range
float64 start_position  # Start position in mm
float64 end_position    # End position in mm

# Test configuration
int32 repetitions       # Repetitions per algorithm (default: 1)

# Operator and metadata
string operator_name    # Name of operator performing test
string notes            # Additional notes (e.g. "baseline", "with ND filter")

---
# Response: Verification results

bool success
string status_message

# Output file path
string csv_path

# Summary statistics
float64 reference_position_mm   # Position from ExhaustiveAutofocus
float64 max_deviation_mm        # Maximum deviation from reference
float64 total_duration_seconds  # Total test duration
int32 total_measurements        # Total measurements across all algorithms
